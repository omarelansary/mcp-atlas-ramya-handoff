# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Ruff
.ruff_cache

.DS_Store

.env
# Backups and per-environment variants carry the same credentials as .env, and
# the bare ".env" rule above does not match them.
.env.*
!.env.example
!.env.template

# Eval results (keep folders, ignore contents)
services/mcp_eval/completion_results/*
services/mcp_eval/evaluation_results/*
!services/mcp_eval/completion_results/.gitkeep
!services/mcp_eval/evaluation_results/.gitkeep
# Ranker score caches. Generated by the P1-026 ranking path, ~7.4 MB and
# growing, and reproducible from the pinned models. They exist to make reranker
# scoring repeatable across runs, not to be shared: gap 6 is closed for
# reproducibility by rebuilding this cache, never by committing it.
services/p1_026_ranker_cache/
