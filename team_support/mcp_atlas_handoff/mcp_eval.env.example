# Copy this file to:
# /home/omel305g/masters_workspace/mcp-atlas/services/mcp_eval/.env
#
# Do not commit the real .env file.

LLM_API_KEY=<LLM_API_KEY>
LLM_BASE_URL=https://llm.scads.ai/v1

# Optional. If omitted by the runtime, evaluator calls may fall back to LLM_API_KEY/LLM_BASE_URL
# depending on MCP-Atlas/LiteLLM configuration.
EVAL_LLM_API_KEY=<EVAL_LLM_API_KEY>
EVAL_LLM_BASE_URL=https://llm.scads.ai/v1
EVAL_LLM_MODEL=openai/alias-ha

MCP_SERVER_URL=http://127.0.0.1:1984
SERVER_URL=http://127.0.0.1:3000
